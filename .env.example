# INSTRUCCIONES:
#   1. Copiar: cp .env.example .env
#   2. Llenar TODOS los campos marcados como [REQUERIDA]
#   3. Revisar los [opcional] y ajustar si el default no aplica
#
# Generar claves seguras:
#   python -c "import secrets; print(secrets.token_hex(64))"
#
# Leyenda:
#   [REQUERIDA]       La app se niega a arrancar si falta.
#   [REQUERIDA prod]  Solo requerida en produccion - tiene default para dev.
#   [opcional]        Tiene un default razonable, cambiar si necesitas otro.
# ==============================================================================


# -- Servidor ------------------------------------------------------------------
# [opcional] Modo debug. NUNCA "true" en produccion.
# En produccion arrancar con:
#   gunicorn --worker-class gthread --workers 4 --threads 4
#            --bind 0.0.0.0:5000 --timeout 120 "app:create_app()"
FLASK_DEBUG=false
PORT=5000
FLASK_TESTING=false


# -- CORS ----------------------------------------------------------------------
# [REQUERIDA prod] Origenes del frontend separados por coma. NUNCA usar "*".
# Dev: se usan http://localhost:5173 y http://localhost:8081 como fallback.
# Prod: poner la URL exacta del frontend (con https).
#
# Ejemplo produccion:
#   CORS_ORIGINS=https://centralgo.net,https://www.centralgo.net
CORS_ORIGINS=


# -- Frontend URL --------------------------------------------------------------
# [REQUERIDA prod] URL base del frontend.
# Controla el flag Secure y SameSite de la cookie del refresh token:
#   http://localhost... -> Secure=False, SameSite=Lax   (dev HTTP)
#   https://...         -> Secure=True,  SameSite=None  (prod HTTPS)
#
# Ejemplo produccion:
#   FRONTEND_URL=https://centralgo.net
FRONTEND_URL=http://localhost:5173


# -- JWT - Access token --------------------------------------------------------
# [REQUERIDA] Clave para firmar los access tokens (duracion corta: 15 min).
# Si se filtra, un atacante puede fabricar tokens de cualquier usuario.
# Generar con: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=
JWT_EXPIRATION_MINUTES=15


# -- JWT - Refresh token -------------------------------------------------------
# [REQUERIDA] Clave DISTINTA a SECRET_KEY.
# Principio: claves separadas por proposito (comprometer una no compromete otra).
# Generar con: python -c "import secrets; print(secrets.token_hex(64))"
REFRESH_SECRET_KEY=
REFRESH_TOKEN_EXPIRATION_DAYS=30


# -- Rate limiting -------------------------------------------------------------
# [opcional]
#   Dev:  memory://            (se reinicia con el servidor)
#   Prod: redis://redis:6379/1 (compartido entre workers de gunicorn)
#
# IMPORTANTE prod: con gunicorn -w 4, memory:// cuenta por separado en cada
# worker. Usar Redis garantiza el limite global correcto.
# NOTA: en docker-compose.yml se sobreescribe automaticamente.
LIMITER_STORAGE_URI=memory://


# -- Base de datos principal ---------------------------------------------------
# [REQUERIDA] PostgreSQL con el schema del proyecto.
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=5432


# -- Base de datos de telemetria -----------------------------------------------
# [REQUERIDA] Servidor de telemetria (donde vive t_data y t_eventos).
# En dev puede apuntar a la misma instancia que DB_HOST.
# En prod es el servidor remoto dedicado a la ingesta de GPS.
#
# IMPORTANTE: pool conservador (POOL_MAX_TELEMETRY=8) porque el servidor
# es compartido con otros servicios. No subir sin coordinar con el admin.
TELEMETRY_DB_HOST=
TELEMETRY_DB_NAME=
TELEMETRY_DB_USER=
TELEMETRY_DB_PASSWORD=
TELEMETRY_DB_PORT=5432


# -- Redis ---------------------------------------------------------------------
# [REQUERIDA prod] URL de Redis para:
#   1. Pub/Sub del POI Worker -> SSE (eventos de geocerca en tiempo real)
#   2. Rate limiting compartido entre workers de gunicorn
#
# Formatos:
#   Sin password (dev):   redis://localhost:6379/0
#   Con password (prod):  redis://:tu_password@localhost:6379/0
#   Con TLS (prod):       rediss://:tu_password@host:6380/0
#
# Instalar Redis en el servidor:
#   Ubuntu: sudo apt install redis-server && sudo systemctl enable redis
#   Verificar: redis-cli ping  (debe responder PONG)
#
# NOTA: en docker-compose.yml se sobreescribe automaticamente con redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0


# -- POI Worker ----------------------------------------------------------------
# [opcional] Segundos entre cada ciclo de deteccion de geocercas. Default: 15.
# Bajar a 10s si necesitas menor latencia (mayor carga en BD).
# Subir a 30s si el servidor de telemetria tiene restricciones de conexion.
WORKER_POLL_INTERVAL=15

# [opcional] "false" para deshabilitar el worker completamente.
# Util en: tests unitarios, entornos sin Redis, debugging.
WORKER_ENABLED=true


# -- Frontend (Vite build-time - embebido en el JS compilado) ------------------
# [opcional] URL del backend para el frontend.
# Vacio = llamadas relativas (nginx proxea a api:5000). Recomendado con Docker.
# Solo poner URL absoluta si el frontend llama directo al backend sin nginx.
VITE_API_URL=

# [REQUERIDA] API Key de Google Maps para el mapa en tiempo real.
# Obtener en: https://console.cloud.google.com/apis/credentials
# APIs necesarias: Maps JavaScript API, Places API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=


# ==============================================================================
# CHECKLIST DE PRODUCCION
# ==============================================================================
# Antes de desplegar a produccion, verificar:
#
# Backend:
#   [ ] FLASK_DEBUG=false
#   [ ] SECRET_KEY y REFRESH_SECRET_KEY son claves de 128 chars distintas
#   [ ] DB_PASSWORD y TELEMETRY_DB_PASSWORD configurados
#   [ ] REDIS_URL apunta a Redis con password
#   [ ] CORS_ORIGINS tiene la URL exacta del frontend (con https)
#   [ ] FRONTEND_URL tiene la URL exacta del frontend (con https)
#   [ ] LIMITER_STORAGE_URI=redis://... (no memory://)
#   [ ] WORKER_ENABLED=true
#
# Infraestructura:
#   [ ] Redis instalado, corriendo y asegurado con password
#   [ ] Gunicorn con --worker-class gthread y --timeout 120
#   [ ] nginx con proxy_buffering off para /events/ (SSE)
#   [ ] Migraciones 005 y 006 aplicadas en la BD
# ==============================================================================
